{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build login (ODBC)",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}\\login.cpp",
                "-o",
                "${workspaceFolder}\\login.exe",
                "-lodbc32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run login",
            "type": "process",
            "command": "${workspaceFolder}\\login.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build login (ODBC)",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
